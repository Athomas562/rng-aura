{
  // Worker Cloudflare : environnement Web standard (fetch, Request, WebCrypto), ni DOM ni Node.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["worker"],
  "exclude": ["worker/**/*.test.ts", "worker/testing"]
}
