{
  // Tests du Worker et outils de migration : exécutés par Node (node:sqlite, node:fs),
  // séparés de tsconfig.worker.json pour que le code du Worker reste sans types Node.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker-tests.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["worker/**/*.test.ts", "worker/testing", "scripts"]
}
